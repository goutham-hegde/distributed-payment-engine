<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.dpe</groupId>
        <artifactId>distributed-payment-engine</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>account-service</artifactId>
    <name>account-service</name>
    <description>Owns the money: accounts, double-entry ledger, holds, row-level locking</description>

    <dependencies>
        <dependency>
            <groupId>com.dpe</groupId>
            <artifactId>common-events</artifactId>
        </dependency>

        <!-- M3: the outbox relay and the inbox gate, shared by all three services. It brings
             spring-boot-starter-data-jpa and spring-boot-starter-kafka with it. -->
        <dependency>
            <groupId>com.dpe</groupId>
            <artifactId>common-messaging</artifactId>
        </dependency>
        <!-- M5: token validation - the decoder, the validators and the role vocabulary. The
             authorization RULES stay in this service's own SecurityConfig; see JwtConfig. -->
        <dependency>
            <groupId>com.dpe</groupId>
            <artifactId>common-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- M6: the Prometheus exposition format on /actuator/prometheus. Actuator alone gives
             the endpoint list and the metrics API; it does not give a registry that can SERIALISE
             them for a scraper - that is this artifact, and without it /actuator/prometheus is
             simply absent, which looks like an exposure typo rather than a missing dependency.

             Version comes from micrometer-bom, imported by spring-boot-dependencies. There is no
             spring-boot-starter-prometheus in Boot 4 to look for; the registry is depended on
             directly, as it was in Boot 3. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- M1: the ledger needs persistence, migrations and a Postgres driver. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- M2: the transactional outbox needs somewhere to relay to. Boot 4 folded
             spring-kafka into a starter; the Boot 3 coordinate `org.springframework.kafka:spring-kafka`
             still resolves but brings no auto-configuration and no managed version. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>

        <!-- Spring Boot 4 splits the old monolithic spring-boot-starter-test into per-module
             test starters. You need one per production starter you actually test against. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers 2.x renamed every module: `org.testcontainers:redpanda` is the
             1.x coordinate and stops at 1.21.4. The class moved too, to
             org.testcontainers.redpanda.RedpandaContainer, and like PostgreSQLContainer it
             is no longer generic. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-redpanda</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- M5: MockMvc, for the HTTP security tests. This service had no web test starter
             until now because nothing here drove an endpoint from a test - the ledger and the
             saga are exercised through their services. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- M5: MockMvc's security helpers and the resource-server test support. Boot 4 splits
             these out per technology, like every other test starter. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
